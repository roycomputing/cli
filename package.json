{
  "name": "@roycomputing/cli",
  "version": "0.1.1",
  "description": "Manage RoyComputing computers and containers from your terminal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roycomputing/cli.git"
  },
  "bin": {
    "roy": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "oxlint --format=agent src && tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.11.2"
}
